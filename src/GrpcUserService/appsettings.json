{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Grpc": "Information"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=user_service_db;Username=postgres;Password=postgres"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "UserRegisteredTopic": "user-registered",
    "UserDeletedTopic": "user-deleted",
    "PointsSpentTopic": "points-spent",
    "PointsAddedTopic": "points-added",
    "PointsCompensatedTopic": "points-compensated",
    "Acks": "all",
    "EnableIdempotence": true,
    "MaxInFlight": 5,
    "RetryBackoffMs": 100,
    "MessageSendMaxRetries": 3
  },
  "Kestrel": {
    "Endpoints": {
      "Http2": {
        "Url": "http://0.0.0.0:5000",
        "Protocols": "Http2"
      }
    }
  }
}
